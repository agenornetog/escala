# Configure localmente com npm run auth:setup. Nunca versionar .env.local.
# Na hospedagem, cadastrar os valores reais nas variáveis privadas do servidor.
ESCALA_ADMIN_EMAIL=
# Formato: scrypt$<salt hexadecimal de 32 caracteres>$<hash hexadecimal de 128 caracteres>
# Em arquivos .env, os sinais $ precisam ser escapados como \$.
ESCALA_ADMIN_PASSWORD_HASH=
# Segredo aleatório de pelo menos 32 caracteres, gerado pelo setup local.
ESCALA_SESSION_SECRET=
