# Janela temporária de testes: vence em 08/11/2026 às 15:40:22 (Brasília).
# true exige login imediatamente; false não prolonga a data fixa do código.
ESCALA_REQUIRE_LOGIN=false

# Configure localmente com npm run auth:setup. Nunca versionar .env.local.
# Na hospedagem, cadastrar os valores reais nas variáveis privadas do servidor.
ESCALA_ADMIN_EMAIL=
# Formato: scrypt$<salt hexadecimal de 32 caracteres>$<hash hexadecimal de 128 caracteres>
# Em arquivos .env, os sinais $ precisam ser escapados como \$.
ESCALA_ADMIN_PASSWORD_HASH=
# Segredo aleatório de pelo menos 32 caracteres, gerado pelo setup local.
ESCALA_SESSION_SECRET=

# Alternativa simples na Vercel: senha privada de 12 a 256 caracteres.
# Configure este campo OU o hash acima (o hash tem prioridade), nunca NEXT_PUBLIC_.
ESCALA_ADMIN_PASSWORD=

# Acesso individual dos colaboradores: executar supabase/employee-access.sql.
# Apenas variáveis privadas do servidor, nunca NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Identificador fixo e único desta instalação (não alterar depois de cadastrar).
ESCALA_WORKSPACE_ID=
